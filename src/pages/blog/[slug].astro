---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date } = post.data;
const formatted = new Intl.DateTimeFormat('es', { dateStyle: 'long' }).format(date);
---

<Layout title={title} description={description}>
	<main class="container post">
		<article>
			<h1 class="post__title">{title}</h1>
			<time class="post__meta" datetime={date.toISOString()}>{formatted}</time>
			<p class="post__description">{description}</p>
			<Content />
		</article>
	</main>
</Layout>
