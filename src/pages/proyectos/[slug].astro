---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
const BASE = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const projectURL = new URL(Astro.url.pathname, Astro.site);
---

<Layout
	title={project.title}
	description={project.subtitle || project.description}
	jsonLd={{
		'@context': 'https://schema.org',
		'@type': 'CreativeWork',
		name: project.title,
		description: project.subtitle || project.description,
		url: projectURL.href,
		image: new URL(project.image, Astro.site).href,
		author: { '@type': 'Person', name: 'John Berroa' },
	}}
>
	<main class="container project-detail">
		<a class="back-link" href={`${BASE}`}>
			<svg
				width="18"
				height="18"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M19 12H5" />
				<path d="m12 19-7-7 7-7" />
			</svg>
			Back to home
		</a>
		<figure class="project-detail__figure">
			<img
				src={project.image}
				alt={project.title}
				transition:name={`project-${project.slug}`}
			/>
		</figure>
		<div class="project-detail__body">
			<h1 class="project-detail__title">{project.title}</h1>
			<p class="project-detail__subtitle">{project.subtitle}</p>
			<p class="project-detail__description">{project.description}</p>
			<Button
				label="Ver proyecto"
				href={project.link ?? '#'}
				target={project.link ? '_blank' : undefined}
				variant="primary"
			/>
		</div>
	</main>
</Layout>
