---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
	ogType?: string;
	jsonLd?: object | object[];
}

const {
	title,
	description = 'Portafolio de John Berroa: proyectos web reales (pastelería, bebidas, tecnología), diseño UX/UI en Figma y desarrollo frontend con HTML/CSS/JS, Astro y Vue.',
	image = 'og-card.png',
	ogType = 'website',
	jsonLd,
} = Astro.props;

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${BASE}${image}`, Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#ffcc00" />
		<link rel="icon" href={`${BASE}favicon.ico`} />
		<link rel="apple-touch-icon" href={`${BASE}apple-touch-icon.png`} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@100..900&family=Inter:wght@100..900&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="John Berroa" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="es_AR" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<ClientRouter />
		{jsonLd && <JsonLd data={jsonLd} />}
	</head>
	<body id="top">
		<Nav />
		<slot />
		<Footer />

		<div id="loader" class="loader" transition:persist="loader" aria-hidden="true">
			<img class="loader__img" src={`${BASE}logo-johnberroa.svg`} alt="" />
			<div class="loader__track">
				<div id="loader-bar" class="loader__bar" role="progressbar" aria-label="Cargando portafolio"></div>
			</div>
		</div>

		<script is:inline>
			(function () {
				const loader = document.getElementById('loader');
				const bar = document.getElementById('loader-bar');
				if (!loader || !bar) return;

				if (sessionStorage.getItem('portfolio-loader-shown')) {
					loader.classList.add('loader--hidden');
					return;
				}
				sessionStorage.setItem('portfolio-loader-shown', '1');

				const DURATION = 5000;
				const startedAt = Date.now();
				let progress = 0;
				const timer = setInterval(() => {
					const elapsed = Date.now() - startedAt;
					const target = Math.min((elapsed / DURATION) * 100, 100);
					progress = Math.min(Math.max(target + Math.random() * 4 - 2, 0), 100);
					bar.style.width = `${progress}%`;
					if (progress >= 100) {
						clearInterval(timer);
						loader.classList.add('loader--done');
						setTimeout(() => loader.classList.add('loader--hidden'), 600);
					}
				}, 200);
			})();
		</script>
	</body>
</html>
