---
interface Props {
	href?: string;
	label: string;
	variant?: 'primary' | 'ghost';
	target?: string;
}

const { href = '#', label, variant = 'primary', target } = Astro.props;
---

<a
	class={`btn btn--${variant}`}
	href={href}
	target={target}
	rel={target === '_blank' ? 'noopener' : undefined}
	>{label}</a
>
